if(PROBE STREQUAL "helper")
    set(fixture "legacy-helper.txt")
    set(expected "1ee7af1cd0ef4f10d62b7853ec778e9af657130ecdce1ab40fd4fb174bad47d4")
elseif(PROBE STREQUAL "defined_edge")
    set(fixture "legacy-edge.txt")
    set(expected "45754f69f5aca49c8661a7e60454064dcd3144b752f3b6318434c6e5389c4912")
elseif(PROBE STREQUAL "board")
    set(fixture "legacy-board.txt")
    set(expected "9d93612d51cd54982a42eaacc9b5299e93a110de52cf32462b0cd11cbc13d2f1")
else()
    message(FATAL_ERROR "unknown Search9 proof")
endif()
file(SHA256 "${FIXTURES}/${fixture}" actual_hash)
if(NOT actual_hash STREQUAL expected)
    message(FATAL_ERROR "Search9 immutable fixture hash mismatch")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(output "${OUTPUT_DIR}/${PROBE}.txt")
if(PROBE STREQUAL "board")
    execute_process(COMMAND "${PROGRAM}" "${ROOT}" OUTPUT_FILE "${output}" RESULT_VARIABLE status)
else()
    execute_process(COMMAND "${PROGRAM}" OUTPUT_FILE "${output}" RESULT_VARIABLE status)
endif()
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Search9 proof failed: ${status}")
endif()
if(PROBE STREQUAL "board")
    # Historical optimiser coordinates/work totals are not acceptance criteria.
    # The executable checks physical/source requirements and independently
    # observed receipts; compare complete CURRENT output across fresh processes.
    set(reference "${OUTPUT_DIR}/${PROBE}-repeat.txt")
    execute_process(COMMAND "${PROGRAM}" "${ROOT}" OUTPUT_FILE "${reference}" RESULT_VARIABLE repeated_status)
    if(NOT repeated_status STREQUAL "0")
        message(FATAL_ERROR "Search9 repeated board proof failed: ${repeated_status}")
    endif()
else()
    set(reference "${FIXTURES}/${fixture}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${output}" "${reference}" RESULT_VARIABLE same)
if(NOT same STREQUAL "0")
    message(FATAL_ERROR "Search9 complete output mismatch: ${output}")
endif()
