      (pin input line (at 0 0 0) (length 2.54) (name "IN") (number "1"))))
  (symbol "Drivers"
    (symbol "Drivers_1_1"
      (pin output line (at 0 0 0) (length 2.54) (name "OUT") (number "1"))
