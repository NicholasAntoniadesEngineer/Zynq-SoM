(kicad_symbol_lib (version 20251024) (generator "schgen_contracts")
  (symbol "Mixed" (pin_names hide) (pin_numbers (hide no))
    (symbol "Mixed_0_1"
      (symbol "Mixed_nested"
        (pin input line (at -2.54 1.27 -450.9) (length 1.27)
          (name "nested") (number 10) hide))
      (pin output inverted (at 2.54 -1.27 450.9) (name "child") (number "2") (hide yes))
      (rectangle (start -3 -4) (end 4 5))
      (polyline (pts (xy -6 2) (xy 3 7)))
      (circle (center 8 -2) (radius 3))
      (arc (start -9 1) (mid -2 -8) (end 2 6)))
    (pin passive line (at 0 0) (length 0) (name "top") (number "2") (hide no)))
  (symbol "PinOnly"
    (pin passive line (at -2.54 3.81 0) (number "A1"))
    (pin power_in line (at 5.08 -1.27 180) (number "B2")))
  (symbol "Empty")
  (symbol "Defaults" (pin))
  (symbol "BarePinHide" (pin passive line (at 0 0) hide))
  (symbol "EmptyPinHide" (pin passive line (at 0 0) (hide)))
  (symbol "NumericQuotes" (pin passive line (at "1.27" "-2.54" "-450.9")
    (number 1.123456789) (name 1e-8) (length "0") "hide"))
  (symbol "OffGrid" (pin passive line (at 0.1 0) (number "1")))
  (symbol "GridInside" (pin passive line (at 1.2701269 -1.2701269) (number "1")))
  (symbol "GridOutside" (pin passive line (at 1.2701271 0) (number "1")))
  (symbol "BrokenAt" (pin passive line (at 0) (number "1")))
  (symbol "Nonfinite" (pin passive line (at "nan" 0) (number "1")))
  (symbol "ArcBounds" (arc (start 1 2) (mid 3 4) (end 5 6)))
  (symbol "Base" (pin_names hide) (pin_numbers hide)
    (in_bom yes) (on_board yes)
    (property "Reference" "U" (at 0 2.54 0))
    (property "Value" "Base" (at 0 -2.54 0))
    (property "Custom" "inherited")
    (symbol "Base_0_1" (rectangle (start -2.54 -2.54) (end 2.54 2.54)))
    (symbol "Base_1_1" (pin input line (at -5.08 0 0) (number "1") (name "A")))
    (symbol "Base_2_1" (pin output line (at 5.08 0 180) (number "2") (name "B")))
    (symbol "Base_2_2" (pin output line (at 5.08 0 180) (number "2") (name "B_ALT"))))
  (symbol "Child" (extends "Base") (property "Value" "Child") (property "Added" "new"))
  (symbol "Grandchild" (extends "Child") (property "Custom" "") (property "Value" "Grandchild"))
  (symbol "MissingParent" (extends "Absent"))
  (symbol "CycleA" (extends "CycleB"))
  (symbol "CycleB" (extends "CycleA"))
  (symbol "SelfCycle" (extends "SelfCycle"))
  (symbol "DerivedDrawing" (extends "Base") (rectangle (start 0 0) (end 1 1)))
)
