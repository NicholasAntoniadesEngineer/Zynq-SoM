+void trade_contracts() {
+    for(int span=0;span<=64;++span)for(int seed=0;seed<7;++seed) {
+        const auto run=[&] {
+            std::vector<std::pair<int,int>> calls;
+            std::set<std::pair<int,int>> unique;
+            int area=165*158;
+            floorplan_detail::multiscale_outline_trade_indices(span,[&](int i,int j) {
+                require(i>=-span&&i<=span&&j>=-span&&j<=span,"trade left search window");
+                require(unique.emplace(i,j).second,"trade repeated a candidate");
+                calls.emplace_back(i,j);
+                const int candidate=(165-i)*(158-j);
+                if(candidate<area&&(i+j+seed)%7!=0) {area=candidate;return true;}
+                return false;
+            });
+            int levels=0;for(int s=span;s>0;s/=2)++levels;
+            require(calls.size()<=static_cast<std::size_t>(7*levels),"trade exceeded declared work bound");
+            return calls;
+        };
+        require(run()==run(),"trade schedule not reproducible");
+    }
+    bool recovered=false;
+    floorplan_detail::multiscale_outline_trade_indices(40,[&](int i,int j) {
+        if(i==-1&&j==2){recovered=true;return true;}return false;
+    });
+    require(recovered,"failed shrink/large trades pruned wider-shorter feasible island");
+    int calls=0;bool threw=false;
+    try{floorplan_detail::multiscale_outline_trade_indices(40,[&](int,int)->bool{++calls;throw std::runtime_error("injected");});}
+    catch(const std::runtime_error&){threw=true;}
+    require(threw&&calls==1,"trade swallowed or retried callback error");
+    threw=false;
+    try{floorplan_detail::multiscale_outline_trade_indices(-1,[&](int,int){++calls;return false;});}
+    catch(const std::invalid_argument&){threw=true;}
+    require(threw&&calls==1,"negative trade span reached callback");
+    floorplan_detail::multiscale_outline_trade_indices(std::numeric_limits<int>::max(),[](int,int){return false;});
+}
