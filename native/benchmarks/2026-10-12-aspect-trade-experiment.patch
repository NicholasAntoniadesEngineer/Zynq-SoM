diff --git a/native/src/multiscale_outline_internal.hpp b/native/src/multiscale_outline_internal.hpp
index c6eadef8..4b862662 100644
--- a/native/src/multiscale_outline_internal.hpp
+++ b/native/src/multiscale_outline_internal.hpp
@@ -1,5 +1,6 @@
 #pragma once
 #include <array>
+#include <set>
 #include <stdexcept>
 #include <utility>
 
@@ -24,4 +25,34 @@ template<class Visit> void multiscale_outline_indices(int span,Visit&& visit) {
         }
     }
 }
+
+// A small additional portfolio around the incumbent after shrink refinement.
+// Negative indices expand one dimension. Visit owns strict area improvement
+// and physical feasibility; an unsuccessful trial cannot move the anchor.
+// One sweep per scale keeps cost at most seven queries per scale, independent
+// of feasibility islands. This is a search-effort window, not a physical limit.
+template<class Visit> void multiscale_outline_trade_indices(int span,Visit&& visit) {
+    if(span<0)throw std::invalid_argument("negative outline refinement span");
+    if(span==0)return;
+    int stride=1;
+    while(stride<=span/2)stride*=2;
+    int best_i=0,best_j=0;
+    std::set<std::pair<int,int>> seen{{0,0}};
+    for(;stride>0;stride/=2) {
+        const int i=best_i,j=best_j;
+        // Use wide arithmetic so twice the stride and signed window offsets
+        // remain defined even for a caller-provided INT_MAX span.
+        const long long s=stride;
+        for(const auto& [di,dj]:std::array<std::pair<long long,long long>,7>{{
+                {-s,s},{s,-s},{-s,2*s},{2*s,-s},{s,0},{0,s},{s,s}}}) {
+            const auto ni=i+di,nj=j+dj;
+            if(ni < -static_cast<long long>(span)||ni>span||
+               nj < -static_cast<long long>(span)||nj>span)continue;
+            const auto point=std::pair{static_cast<int>(ni),static_cast<int>(nj)};
+            if(seen.insert(point).second&&visit(point.first,point.second)) {
+                best_i=point.first;best_j=point.second;
+            }
+        }
+    }
+}
 }
