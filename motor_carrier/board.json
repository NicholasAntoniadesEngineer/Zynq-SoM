{
  "schema": "schgen.board/1",
  "name": "motor_carrier",
  "files": {
    "stem": "Zynq_Motor_Carrier"
  },
  "root_readme": false,
  "owned_groups": [],
  "module": {
    "folder": "som",
    "pairs": [],
    "loads": [
      {
        "connector": "J2",
        "rail": "+3V3",
        "amps": 0.03,
        "note": "Zynq banks 13+33 VCCO: 12 LVCMOS33 outputs to high-impedance CMOS inputs (8 ESC PWM, #OE, idle select, CAN TX, UART RTS) + on-SoM BMI323 VDDIO rider; estimate, the devkit_mini figure plus half"
      },
      {
        "connector": "J3",
        "rail": "+3V3",
        "amps": 0.03,
        "note": "Zynq banks 34+35 VCCO: bank 34 drives the 32 expansion-header pins when a daughter card is fitted, bank 35 unused; estimate"
      }
    ]
  },
  "power": {
    "sources": [
      {
        "rail": "+VBUS_IN",
        "volts": 20.0,
        "amps": 3.0,
        "basis": "USB-C PD sink contract 20 V / 3 A at the receptacle (pd_input J1; +VIN sits behind the TPS26631 eFuse, round 5)"
      },
      {
        "rail": "+3V3_SC",
        "supplier": "module"
      },
      {
        "rail": "+VESC_IN",
        "volts": 25.2,
        "amps": 30.0,
        "basis": "ESC battery at the XT60 inlet (esc_power J1): 6S pack at 4.2 V per cell = 25.2 V, the highest supported pack. 30 A continuous is the board design current: the 40 A fuse F1 derated 25 % for continuous operation (Littelfuse 456 series sheet, revised 11/22/19) and inside the XT60PW-M rated current of 35 A at 85 K rise (AMASS product specification XT60PW-M30.G.Y.T, version 2025V0)"
      }
    ],
    "rails": [
      {
        "rail": "+5V_REG",
        "volts": 5.0,
        "basis": "LM61460 power:U1 set-point target; its FB divider R1/R2 = 40k2/10k sets 1.0 V x (1 + 40200/10000) = 5.02 V, checked against this target by the spice fb_divider gate (+/-3 %)"
      },
      {
        "rail": "+3V3_REG",
        "volts": 3.3,
        "basis": "LM61460 power:U2 set-point target; its FB divider R4/R5 = 23k2/10k sets 1.0 V x (1 + 23200/10000) = 3.32 V, checked against this target by the spice fb_divider gate (+/-3 %)"
      },
      {
        "rail": "+5V_SOM",
        "volts": 4.65,
        "basis": "LM61460 power_som:U4 set-point target: the regulated 4.65 V SoM input (P0 rebind); its FB divider R14/R15 = 47k5/13k sets 1.0 V x (1 + 47500/13000) = 4.654 V, checked against this target by the spice fb_divider gate (+/-3 %)"
      },
      {
        "rail": "USB_UART_VBUS",
        "volts": 5.0,
        "basis": "host-supplied USB VBUS of the UART USB-C receptacle (usb_uart_connector J1); feeds the CP2102N VBUS-sense divider on uart_bridge"
      },
      {
        "rail": "+VPRE",
        "volts": 8.0,
        "basis": "LM61460 vbat_supply:U2 set-point target, the battery-derived logic feed; its FB divider R8/R9 = 47k5/6k8 sets 1.0 V x (1 + 47500/6800) = 7.985 V, checked against this target by the spice fb_divider gate (+/-3 %). 8 V stays in regulation down to the 9.15 V eFuse turn-on and keeps +VIN below the 20 V the reused chain is rated for"
      },
      {
        "rail": "+VESC_MID",
        "volts": 25.2,
        "basis": "common-source node of the two protection FETs esc_power:Q1/Q2, at the inlet voltage when the path is on; a transistor is not a part the tool passes a voltage through"
      },
      {
        "rail": "+VESC_P",
        "volts": 25.2,
        "basis": "output of the ideal-diode FET esc_power:Q2 (LM74930 C pin), the protected ESC rail ahead of the shunt; same reason as +VESC_MID"
      },
      {
        "rail": "+VBAT_D",
        "volts": 25.2,
        "basis": "battery logic feed behind the reverse-blocking Schottky vbat_supply:D2 (SS54, VF at most 0.55 V at 5 A, MDD SS52-SS5200 sheet Rev 2024A4); stated at the inlet voltage, the worst case for ratings; a diode is not a part the tool passes a voltage through"
      },
      {
        "rail": "+VIN",
        "volts": 20.0,
        "basis": "common pin of the supply selector vbat_supply:J1, fed by exactly one of +VIN_PD (20 V USB-C PD contract behind the pd_input eFuse) or +VPRE (8 V); 20 V is the higher of the two and is the value every rating on +VIN and +VIN_SYS is checked at. A header is not a part the tool can pass a voltage through"
      }
    ],
    "inlet": {
      "rail": "+VBUS_IN",
      "bulk": "+VIN_PD"
    }
  },
