(version 1)

# Generated by schgen/constraints.py from typed ports.
# Stackup: JLCPCB JLC04161H-7628 (4L 1.6mm, 7628 prepreg 0.2104mm).
# Geometry source: JLCPCB impedance calculator for this stackup
# (90R diff: 0.2611/0.2032mm; 100R diff: 0.2052/0.2032mm, outer vs L2).
# Assign nets to the classes listed in layout_constraints.csv first.

(rule "DP100_DIFF_geometry"
  (condition "A.NetClass == 'DP100_DIFF'")
  (constraint track_width (min 0.2052mm) (opt 0.2052mm) (max 0.2052mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP100_TMDS_geometry"
  (condition "A.NetClass == 'DP100_TMDS'")
  (constraint track_width (min 0.2052mm) (opt 0.2052mm) (max 0.2052mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP90_USB_geometry"
  (condition "A.NetClass == 'DP90_USB'")
  (constraint track_width (min 0.2611mm) (opt 0.2611mm) (max 0.2611mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)
