  # FMC LPC (VITA 57.1) — LA09; Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE FMC layout ±5 mil
  (condition "(A.NetName == 'FMC_LA09_P' && B.NetName == 'FMC_LA09_N') || (A.NetName == 'FMC_LA09_N' && B.NetName == 'FMC_LA09_P')")
