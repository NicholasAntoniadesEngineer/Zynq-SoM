  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE FMC layout ±5 mil
  (condition "(A.NetName == 'FMC_LA07_P' && B.NetName == 'FMC_LA07_N') || (A.NetName == 'FMC_LA07_N' && B.NetName == 'FMC_LA07_P')")
