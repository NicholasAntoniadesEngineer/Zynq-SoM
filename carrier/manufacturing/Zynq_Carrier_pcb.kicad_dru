(rule "intra_skew_FMC_LA11_P"
  # FMC LPC (VITA 57.1) — LA11; Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE FMC layout ±5 mil
  (condition "(A.NetName == 'FMC_LA11_P' && B.NetName == 'FMC_LA11_N') || (A.NetName == 'FMC_LA11_N' && B.NetName == 'FMC_LA11_P')")
  (constraint skew (max 0.127mm))
)

(rule "intra_skew_ETH_PHY_MDI0_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 0 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (1000BASE-T, 100Ω±15% MDI); ANSI/TIA-568 link; PHY-vendor (RTL8211F / TI SNLA387) layout: intra-pair ≤ 50 mil, inter-pair ≤ 50 mm (~330 ps)
  (condition "(A.NetName == 'ETH_PHY_MDI0_P' && B.NetName == 'ETH_PHY_MDI0_N') || (A.NetName == 'ETH_PHY_MDI0_N' && B.NetName == 'ETH_PHY_MDI0_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_PHY_MDI1_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 1 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); RTL8211F/TI SNLA387 layout: intra-pair ≤50 mil, inter-pair ≤50 mm
  (condition "(A.NetName == 'ETH_PHY_MDI1_P' && B.NetName == 'ETH_PHY_MDI1_N') || (A.NetName == 'ETH_PHY_MDI1_N' && B.NetName == 'ETH_PHY_MDI1_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_PHY_MDI2_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 2 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); RTL8211F/TI SNLA387 layout: intra-pair ≤50 mil, inter-pair ≤50 mm
  (condition "(A.NetName == 'ETH_PHY_MDI2_P' && B.NetName == 'ETH_PHY_MDI2_N') || (A.NetName == 'ETH_PHY_MDI2_N' && B.NetName == 'ETH_PHY_MDI2_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_PHY_MDI3_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 3 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); RTL8211F/TI SNLA387 layout: intra-pair ≤50 mil, inter-pair ≤50 mm
  (condition "(A.NetName == 'ETH_PHY_MDI3_P' && B.NetName == 'ETH_PHY_MDI3_N') || (A.NetName == 'ETH_PHY_MDI3_N' && B.NetName == 'ETH_PHY_MDI3_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_LINE_MDI_0_P"
  # Gigabit Ethernet (MDI, line-side) — MDI pair 0 (BI_DA, magnetics→RJ45); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15% MDI); TIA-568 1000BASE-T pair order; Bob-Smith term IEEE 802.3 Sec 40.7.1
  (condition "(A.NetName == 'ETH_LINE_MDI_0_P' && B.NetName == 'ETH_LINE_MDI_0_N') || (A.NetName == 'ETH_LINE_MDI_0_N' && B.NetName == 'ETH_LINE_MDI_0_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_LINE_MDI_1_P"
  # Gigabit Ethernet (MDI, line-side) — MDI pair 1 (BI_DB, magnetics→RJ45); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); TIA-568; 802.3 Sec 40.7.1
  (condition "(A.NetName == 'ETH_LINE_MDI_1_P' && B.NetName == 'ETH_LINE_MDI_1_N') || (A.NetName == 'ETH_LINE_MDI_1_N' && B.NetName == 'ETH_LINE_MDI_1_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_LINE_MDI_2_P"
  # Gigabit Ethernet (MDI, line-side) — MDI pair 2 (BI_DC, magnetics→RJ45); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); TIA-568; 802.3 Sec 40.7.1
  (condition "(A.NetName == 'ETH_LINE_MDI_2_P' && B.NetName == 'ETH_LINE_MDI_2_N') || (A.NetName == 'ETH_LINE_MDI_2_N' && B.NetName == 'ETH_LINE_MDI_2_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_LINE_MDI_3_P"
  # Gigabit Ethernet (MDI, line-side) — MDI pair 3 (BI_DD, magnetics→RJ45); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); TIA-568; 802.3 Sec 40.7.1
  (condition "(A.NetName == 'ETH_LINE_MDI_3_P' && B.NetName == 'ETH_LINE_MDI_3_N') || (A.NetName == 'ETH_LINE_MDI_3_N' && B.NetName == 'ETH_LINE_MDI_3_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_HDMI_RX_CLK_P"
  # HDMI RX (TMDS, sink) — TMDS Clock; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4 (Zdiff 100Ω±15%, DC-coupled); inter-pair data-to-clock match ≤ ±10 mm recommended
  (condition "(A.NetName == 'HDMI_RX_CLK_P' && B.NetName == 'HDMI_RX_CLK_N') || (A.NetName == 'HDMI_RX_CLK_N' && B.NetName == 'HDMI_RX_CLK_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_HDMI_RX_D0_P"
  # HDMI RX (TMDS, sink) — TMDS Data0; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4; CTS skew 0.15·Tbit ≈ ±3 mm
  (condition "(A.NetName == 'HDMI_RX_D0_P' && B.NetName == 'HDMI_RX_D0_N') || (A.NetName == 'HDMI_RX_D0_N' && B.NetName == 'HDMI_RX_D0_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_HDMI_RX_D1_P"
  # HDMI RX (TMDS, sink) — TMDS Data1; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4; CTS skew 0.15·Tbit ≈ ±3 mm
  (condition "(A.NetName == 'HDMI_RX_D1_P' && B.NetName == 'HDMI_RX_D1_N') || (A.NetName == 'HDMI_RX_D1_N' && B.NetName == 'HDMI_RX_D1_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_HDMI_RX_D2_P"
  # HDMI RX (TMDS, sink) — TMDS Data2; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4 (Zdiff=100Ω±15%, DC-coupled, far-end term to AVCC 3.3V±5%); CTS intra-pair skew 0.15·Tbit ≈ ±3 mm (~118 mil)
  (condition "(A.NetName == 'HDMI_RX_D2_P' && B.NetName == 'HDMI_RX_D2_N') || (A.NetName == 'HDMI_RX_D2_N' && B.NetName == 'HDMI_RX_D2_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_ZYNQ_HDMI_TX_TMDS_0_P"
  # HDMI TX (TMDS, source) — TMDS Data0; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4; CTS skew 0.15·Tbit ≈ ±3 mm
  (condition "(A.NetName == 'ZYNQ_HDMI_TX_TMDS_0_P' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_0_N') || (A.NetName == 'ZYNQ_HDMI_TX_TMDS_0_N' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_0_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_ZYNQ_HDMI_TX_TMDS_1_P"
  # HDMI TX (TMDS, source) — TMDS Data1; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4 (Zdiff 100Ω±15%, DC-coupled, 3.3V±5% term); CTS skew 0.15·Tbit ≈ ±3 mm
  (condition "(A.NetName == 'ZYNQ_HDMI_TX_TMDS_1_P' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_1_N') || (A.NetName == 'ZYNQ_HDMI_TX_TMDS_1_N' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_1_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_ZYNQ_HDMI_TX_TMDS_2_P"
  # HDMI TX (TMDS, source) — TMDS Data2; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4 (TMDS Zdiff=100Ω±15% per-pair; sink far-end termination to AVCC=3.3V±5%, DC-coupled); CTS intra-pair skew limit 0.15·Tbit → ±3 mm (~118 mil) per-pair length match
  (condition "(A.NetName == 'ZYNQ_HDMI_TX_TMDS_2_P' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_2_N') || (A.NetName == 'ZYNQ_HDMI_TX_TMDS_2_N' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_2_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_ZYNQ_HDMI_TX_TMDS_CLK_P"
  # HDMI TX (TMDS, source) — TMDS Clock; Zdiff 100ohm; DC-coupled
  # spec: HDMI 1.4b Sec 4.2.4 (Zdiff 100Ω±15%, DC-coupled); inter-pair (clock-to-data) skew budget large but match data pairs to clock ≤ ±10 mm (recommended)
  (condition "(A.NetName == 'ZYNQ_HDMI_TX_TMDS_CLK_P' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_CLK_N') || (A.NetName == 'ZYNQ_HDMI_TX_TMDS_CLK_N' && B.NetName == 'ZYNQ_HDMI_TX_TMDS_CLK_P')")
  (constraint skew (max 2.9972mm))
)

(rule "intra_skew_CAM_CLK_P"
  # MIPI CSI-2 D-PHY (camera) — D-PHY Clock lane; Zdiff 100ohm; DC-coupled
  # spec: MIPI D-PHY (CSI-2): Zdiff=100Ω±20%; HS-RX 100Ω diff termination at receiver; clock-to-data lane skew is the timing reference, intra-pair tight (~±0.5 mm / 20 mil)
  (condition "(A.NetName == 'CAM_CLK_P' && B.NetName == 'CAM_CLK_N') || (A.NetName == 'CAM_CLK_N' && B.NetName == 'CAM_CLK_P')")
  (constraint skew (max 0.508mm))
)

(rule "intra_skew_CAM_D0_P"
  # MIPI CSI-2 D-PHY (camera) — D-PHY Data lane 0; Zdiff 100ohm; DC-coupled
  # spec: MIPI D-PHY (CSI-2): Zdiff=100Ω±20%; lane-to-clock skew budget governs inter-lane match; intra-pair ~±0.5 mm
  (condition "(A.NetName == 'CAM_D0_P' && B.NetName == 'CAM_D0_N') || (A.NetName == 'CAM_D0_N' && B.NetName == 'CAM_D0_P')")
  (constraint skew (max 0.508mm))
)

(rule "intra_skew_CAM_D1_P"
  # MIPI CSI-2 D-PHY (camera) — D-PHY Data lane 1; Zdiff 100ohm; DC-coupled
  # spec: MIPI D-PHY (CSI-2): Zdiff=100Ω±20%; intra-pair ~±0.5 mm; inter-lane match to clock
  (condition "(A.NetName == 'CAM_D1_P' && B.NetName == 'CAM_D1_N') || (A.NetName == 'CAM_D1_N' && B.NetName == 'CAM_D1_P')")
  (constraint skew (max 0.508mm))
)

(rule "intra_skew_USB_UART_DP"
  # USB 2.0 FS (UART console, USB-C UFP) — USB2 D+/D- (CP2102N); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 (90Ω±15% diff); USB-IF FS/HS layout intra-pair ≤150 mil
  (condition "(A.NetName == 'USB_UART_DP' && B.NetName == 'USB_UART_DM') || (A.NetName == 'USB_UART_DM' && B.NetName == 'USB_UART_DP')")
  (constraint skew (max 3.81mm))
)

(rule "intra_skew_DBG_USB_DP"
  # USB 2.0 HS (JTAG debug, USB-C UFP) — USB2 D+/D- (CH347T); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 / 7.1.6 (90Ω±15%); USB-IF HS layout intra-pair ≤150 mil
  (condition "(A.NetName == 'DBG_USB_DP' && B.NetName == 'DBG_USB_DM') || (A.NetName == 'DBG_USB_DM' && B.NetName == 'DBG_USB_DP')")
  (constraint skew (max 3.81mm))
)

(rule "intra_skew_USB_D"
  # USB 2.0 HS (OTG, Type-C host port) — USB2 D+/D- (OTG); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 / 7.1.6 (90Ω±15% differential HS); USB-IF/HS layout: intra-pair ≤150 mil (~1.6 mm), target ≤5 mm
  (condition "(A.NetName == 'USB_D+' && B.NetName == 'USB_D-') || (A.NetName == 'USB_D-' && B.NetName == 'USB_D+')")
  (constraint skew (max 3.81mm))
)

(rule "intra_skew_STM32_USB_D_P"
  # USB 2.0 HS (USB-C PD/device port) — USB2 D+/D- (PD/STM32); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 / 7.1.6 (90Ω±15%); USB-IF HS layout intra-pair ≤150 mil
  (condition "(A.NetName == 'STM32_USB_D_P' && B.NetName == 'STM32_USB_D_N') || (A.NetName == 'STM32_USB_D_N' && B.NetName == 'STM32_USB_D_P')")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_FMC_LPC_VITA_57_1"
  # FMC LPC (VITA 57.1): 14 pair(s) length-matched as a group (inter-pair), tol +/-5 mil
  (condition "A.NetName == 'FMC_CLK0_M2C_P' || A.NetName == 'FMC_CLK0_M2C_N' || A.NetName == 'FMC_CLK1_M2C_P' || A.NetName == 'FMC_CLK1_M2C_N' || A.NetName == 'FMC_LA00_CC_P' || A.NetName == 'FMC_LA00_CC_N' || A.NetName == 'FMC_LA01_CC_P' || A.NetName == 'FMC_LA01_CC_N' || A.NetName == 'FMC_LA02_P' || A.NetName == 'FMC_LA02_N' || A.NetName == 'FMC_LA03_P' || A.NetName == 'FMC_LA03_N' || A.NetName == 'FMC_LA04_P' || A.NetName == 'FMC_LA04_N' || A.NetName == 'FMC_LA05_P' || A.NetName == 'FMC_LA05_N' || A.NetName == 'FMC_LA06_P' || A.NetName == 'FMC_LA06_N' || A.NetName == 'FMC_LA07_P' || A.NetName == 'FMC_LA07_N' || A.NetName == 'FMC_LA08_P' || A.NetName == 'FMC_LA08_N' || A.NetName == 'FMC_LA09_P' || A.NetName == 'FMC_LA09_N' || A.NetName == 'FMC_LA10_P' || A.NetName == 'FMC_LA10_N' || A.NetName == 'FMC_LA11_P' || A.NetName == 'FMC_LA11_N'")
  (constraint skew (max 0.127mm))
)

(rule "lenmatch_LM_GIGABIT_ETHERNET_MDI_PHY_SIDE"
  # Gigabit Ethernet (MDI, PHY-side): 4 pair(s) length-matched as a group (inter-pair), tol +/-50 mil
  (condition "A.NetName == 'ETH_PHY_MDI0_P' || A.NetName == 'ETH_PHY_MDI0_N' || A.NetName == 'ETH_PHY_MDI1_P' || A.NetName == 'ETH_PHY_MDI1_N' || A.NetName == 'ETH_PHY_MDI2_P' || A.NetName == 'ETH_PHY_MDI2_N' || A.NetName == 'ETH_PHY_MDI3_P' || A.NetName == 'ETH_PHY_MDI3_N'")
  (constraint skew (max 1.27mm))
)

(rule "lenmatch_LM_GIGABIT_ETHERNET_MDI_LINE_SIDE"
  # Gigabit Ethernet (MDI, line-side): 4 pair(s) length-matched as a group (inter-pair), tol +/-50 mil
  (condition "A.NetName == 'ETH_LINE_MDI_0_P' || A.NetName == 'ETH_LINE_MDI_0_N' || A.NetName == 'ETH_LINE_MDI_1_P' || A.NetName == 'ETH_LINE_MDI_1_N' || A.NetName == 'ETH_LINE_MDI_2_P' || A.NetName == 'ETH_LINE_MDI_2_N' || A.NetName == 'ETH_LINE_MDI_3_P' || A.NetName == 'ETH_LINE_MDI_3_N'")
  (constraint skew (max 1.27mm))
)

(rule "lenmatch_LM_HDMI_RX_TMDS_SINK"
  # HDMI RX (TMDS, sink): 4 pair(s) length-matched as a group (inter-pair), tol +/-118 mil
  (condition "A.NetName == 'HDMI_RX_CLK_P' || A.NetName == 'HDMI_RX_CLK_N' || A.NetName == 'HDMI_RX_D0_P' || A.NetName == 'HDMI_RX_D0_N' || A.NetName == 'HDMI_RX_D1_P' || A.NetName == 'HDMI_RX_D1_N' || A.NetName == 'HDMI_RX_D2_P' || A.NetName == 'HDMI_RX_D2_N'")
  (constraint skew (max 2.9972mm))
)

(rule "lenmatch_LM_HDMI_TX_TMDS_SOURCE"
  # HDMI TX (TMDS, source): 4 pair(s) length-matched as a group (inter-pair), tol +/-118 mil
  (condition "A.NetName == 'ZYNQ_HDMI_TX_TMDS_0_P' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_0_N' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_1_P' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_1_N' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_2_P' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_2_N' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_CLK_P' || A.NetName == 'ZYNQ_HDMI_TX_TMDS_CLK_N'")
  (constraint skew (max 2.9972mm))
)

(rule "lenmatch_LM_MIPI_CSI_2_D_PHY_CAMERA"
  # MIPI CSI-2 D-PHY (camera): 3 pair(s) length-matched as a group (inter-pair), tol +/-20 mil
  (condition "A.NetName == 'CAM_CLK_P' || A.NetName == 'CAM_CLK_N' || A.NetName == 'CAM_D0_P' || A.NetName == 'CAM_D0_N' || A.NetName == 'CAM_D1_P' || A.NetName == 'CAM_D1_N'")
  (constraint skew (max 0.508mm))
)

(rule "lenmatch_LM_USB_2_0_FS_UART_CONSOLE_USB_C_UFP"
  # USB 2.0 FS (UART console, USB-C UFP): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'USB_UART_DP' || A.NetName == 'USB_UART_DM'")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_USB_2_0_HS_JTAG_DEBUG_USB_C_UFP"
  # USB 2.0 HS (JTAG debug, USB-C UFP): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'DBG_USB_DP' || A.NetName == 'DBG_USB_DM'")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_USB_2_0_HS_OTG_TYPE_C_HOST_PORT"
  # USB 2.0 HS (OTG, Type-C host port): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'USB_D+' || A.NetName == 'USB_D-'")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_USB_2_0_HS_USB_C_PD_DEVICE_PORT"
  # USB 2.0 HS (USB-C PD/device port): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'STM32_USB_D_P' || A.NetName == 'STM32_USB_D_N'")
  (constraint skew (max 3.81mm))
)

