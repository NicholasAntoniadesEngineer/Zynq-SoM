(version 1)

# Generated by schgen/generate/pcb.py — board-level design rules for
# the PCB foundation. Stackup: JLCPCB JLC04161H-7628 (4L 1.6mm).
# Net classes + per-net assignment live in the .kicad_pro net_settings;
# these rules pin the geometry KiCad's DRC enforces.

(rule "minimum_clearance"
  (constraint clearance (min 0.15mm))
)

(rule "minimum_track"
  (constraint track_width (min 0.2032mm))
)

(rule "POWER_track"
  (condition "A.NetClass == 'POWER'")
  (constraint track_width (min 0.4mm) (opt 0.4mm))
)

(rule "DP100_DIFF_geometry"
  (condition "A.NetClass == 'DP100_DIFF'")
  (constraint track_width (min 0.2052mm) (opt 0.2052mm) (max 0.2052mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP100_TMDS_geometry"
  (condition "A.NetClass == 'DP100_TMDS'")
  (constraint track_width (min 0.2052mm) (opt 0.2052mm) (max 0.2052mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP90_USB_geometry"
  (condition "A.NetClass == 'DP90_USB'")
  (constraint track_width (min 0.2611mm) (opt 0.2611mm) (max 0.2611mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

# ==== SI CONSTRAINTS (schgen/generate/si_constraints.py) ====
# Differential-pair + matched-length rules harvested from the schematic's
# typed ports and joined to carrier/research/si_spec.json (researched
# targets, standard-cited). Intra-pair skew = P/N length match within a
# pair; group length = inter-pair match across a port/bus. Enforced by
# KiCad DRC once the pairs are routed. NOT routing — constraints only.

(rule "intra_skew_FMC_CLK0_M2C_P"
  # FMC LPC (VITA 57.1) — CLK0_M2C (MRCC clock); Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 FMC (LA/CLK differential pairs 100Ω); Samtec/TE FMC layout guideline: 100Ω diff, intra-pair ±5 mil, tight inter-pair within LA bus
  (condition "(A.NetName == 'FMC_CLK0_M2C_P' && B.NetName == 'FMC_CLK0_M2C_N') || (A.NetName == 'FMC_CLK0_M2C_N' && B.NetName == 'FMC_CLK0_M2C_P')")
  (constraint skew (max 0.127mm))
)

(rule "intra_skew_FMC_CLK1_M2C_P"
  # FMC LPC (VITA 57.1) — CLK1_M2C (SRCC clock); Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 FMC (100Ω diff); Samtec/TE layout: intra-pair ±5 mil
  (condition "(A.NetName == 'FMC_CLK1_M2C_P' && B.NetName == 'FMC_CLK1_M2C_N') || (A.NetName == 'FMC_CLK1_M2C_N' && B.NetName == 'FMC_CLK1_M2C_P')")
  (constraint skew (max 0.127mm))
)

(rule "intra_skew_FMC_LA00_CC_P"
  # FMC LPC (VITA 57.1) — LA00 (clock-capable); Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 (LA pairs 100Ω diff); Samtec/TE FMC layout: 100Ω, intra-pair ±5 mil, match LA bus to CLK
  (condition "(A.NetName == 'FMC_LA00_CC_P' && B.NetName == 'FMC_LA00_CC_N') || (A.NetName == 'FMC_LA00_CC_N' && B.NetName == 'FMC_LA00_CC_P')")
  (constraint skew (max 0.127mm))
)

(rule "intra_skew_FMC_LA01_CC_P"
  # FMC LPC (VITA 57.1) — LA01 (clock-capable, not CC-routed); Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE layout ±5 mil
  (condition "(A.NetName == 'FMC_LA01_CC_P' && B.NetName == 'FMC_LA01_CC_N') || (A.NetName == 'FMC_LA01_CC_N' && B.NetName == 'FMC_LA01_CC_P')")
  (constraint skew (max 0.127mm))
)

(rule "intra_skew_FMC_LA02_P"
  # FMC LPC (VITA 57.1) — LA02; Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE FMC layout ±5 mil
  (condition "(A.NetName == 'FMC_LA02_P' && B.NetName == 'FMC_LA02_N') || (A.NetName == 'FMC_LA02_N' && B.NetName == 'FMC_LA02_P')")
