  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE FMC layout ±5 mil
  (condition "(A.NetName == 'FMC_LA03_P' && B.NetName == 'FMC_LA03_N') || (A.NetName == 'FMC_LA03_N' && B.NetName == 'FMC_LA03_P')")
