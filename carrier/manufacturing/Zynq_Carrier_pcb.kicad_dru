(rule "intra_skew_FMC_LA10_P"
  # FMC LPC (VITA 57.1) — LA10; Zdiff 100ohm; DC-coupled
  # spec: ANSI/VITA 57.1 (100Ω diff); Samtec/TE FMC layout ±5 mil
  (condition "(A.NetName == 'FMC_LA10_P' && B.NetName == 'FMC_LA10_N') || (A.NetName == 'FMC_LA10_N' && B.NetName == 'FMC_LA10_P')")
  (constraint skew (max 0.127mm))
