{
  "schema": "schgen.escape_triage/1",
  "rules": [
    {
      "pattern": "HDMI_RX_(D\\d|CLK)_[PN]",
      "class": "GENUINE",
      "note": "TMDS sink lane, 742.5 Mbps/lane at 720p60 — eye budget is real"
    },
    {
      "pattern": "ZYNQ_HDMI_TX_TMDS_(\\d|CLK)_[PN]",
      "class": "GENUINE",
      "note": "TMDS source lane, 742.5 Mbps/lane at 720p60 — eye budget is real"
    },
    {
      "pattern": "CAM_(D\\d|CLK)_[PN]",
      "class": "GENUINE",
      "note": "CSI-2 D-PHY lane (LVDS_25 on bank 35) — sub-ns edges"
    },
    {
      "pattern": "FMC_(LA\\d\\d(_CC)?|CLK\\d_M2C)_[PN]",
      "class": "MODERATE",
      "note": "FMC LVDS user pair (LVDS_25) — speed set by the mezzanine, budget relaxed vs TMDS"
    },
    {
      "pattern": "LCD_(R|G|B)\\d",
      "class": "MODERATE",
      "note": "LCD parallel RGB data @ ~33 MHz pixel clock, simultaneous-switching bus"
    },
    {
      "pattern": "LCD_(PCLK|HSYNC|VSYNC|DE)",
      "class": "MODERATE",
      "note": "LCD pixel clock / sync — the timing edge of the parallel RGB bus"
    },
    {
      "pattern": "LCD_CTP_(SDA|SCL|INT|RST)",
      "class": "LOW",
      "note": "capacitive-touch-panel I2C + control — 400 kHz class"
    },
    {
      "pattern": "LCD_(BL_PWM|DISP)",
      "class": "LOW",
      "note": "LCD backlight PWM / display-enable control"
    },
    {
      "pattern": "PMODX?_IO\\d",
      "class": "LOW",
      "note": "PMOD expansion header GPIO"
    },
    {
      "pattern": "DBG_UART_(RXD|TXD)",
      "class": "LOW",
      "note": "debug UART, <= 1 MBd"
    },
    {
      "pattern": "ZYNQ_PS_UART0_(RXD|TXD|CTS_N|RTS_N)",
      "class": "LOW",
      "note": "PS UART + flow control"
    },
    {
      "pattern": "ESC_(PWM_IN\\d|BUF_OE_N|FAULT_N)",
      "class": "LOW",
      "note": "ESC PWM (50-490 Hz class) + buffer control"
    },
    {
      "pattern": "CAM_(EN|LED|SCL|SDA)",
      "class": "LOW",
      "note": "camera control / SCCB I2C"
    },
    {
      "pattern": "HDMI_RX_(CEC|5V_DET)",
      "class": "LOW",
      "note": "HDMI CEC (kHz) / cable-detect level"
    },
    {
      "pattern": "ZYNQ_HDMI_TX_(CEC|HPD|SCL|SDA)",
      "class": "LOW",
      "note": "HDMI CEC / hot-plug / DDC I2C — 100 kHz class"
    },
    {
      "pattern": "SD_CARD_DETECT",
      "class": "LOW",
      "note": "card-detect level"
    },
    {
      "pattern": "(WATCHDOG_(KICK|RST_N)|SC_INT_N|PL_BTN\\d|PUDC_\\d+)",
      "class": "LOW",
      "note": "supervisor watchdog / interrupt / button / pull-up-during-config strap"
    }
  ]
}
