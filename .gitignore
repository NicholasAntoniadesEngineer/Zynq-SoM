# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# KiCad temp/backup files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.log
*.sch-bak
*~
*.lck
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files (we ship our own carrier/manufacturing/bom_jlc.csv)
*.xml

# OS / editor / IDE artefacts
.DS_Store
**/.DS_Store
.history/
**/.history/
.vscode/
.idea/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.tox/
.coverage
htmlcov/
.venv/
venv/
env/
.claude/

# SoM audit working scripts (scratch)
som/.som_audit_*.js

# derived KiCad-exact mirrored footprint cache (schgen/generate/pcb/mirror.py)
.mirrored_fp/

# C++ extension build (scripts/build_native.sh)
native/build/
native/bin/
native/catalog.bin
schgen/_geom*.so
schgen/_geom*.dylib
schgen/*.so

# macOS/iCloud sync duplicates ("file 2.png") — never products, never commit
*[0-9] [0-9].*
* [0-9].*
* [0-9][0-9].*
