(version 1)

# Generated by schgen/generate/pcb.py — board-level design rules for
# the PCB foundation. Stackup: JLCPCB JLC04161H-7628 (4L 1.6mm).
# Net classes + per-net assignment live in the .kicad_pro net_settings;
# these rules pin the geometry KiCad's DRC enforces.

(rule "minimum_clearance"
  (constraint clearance (min 0.15mm))
)

(rule "minimum_track"
  (constraint track_width (min 0.2032mm))
)

(rule "POWER_track"
  (condition "A.NetClass == 'POWER'")
  (constraint track_width (min 0.4mm) (opt 0.4mm))
)

(rule "DP100_DIFF_geometry"
  (condition "A.NetClass == 'DP100_DIFF'")
  (constraint track_width (min 0.2052mm) (opt 0.2052mm) (max 0.2052mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP90_USB_geometry"
  (condition "A.NetClass == 'DP90_USB'")
  (constraint track_width (min 0.2611mm) (opt 0.2611mm) (max 0.2611mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

# ==== SI CONSTRAINTS (schgen/generate/si_constraints.py) ====
# Differential-pair + matched-length rules harvested from the schematic's
# typed ports and joined to carrier/research/si_spec.json (researched
# targets, standard-cited). Intra-pair skew = P/N length match within a
# pair; group length = inter-pair match across a port/bus. Enforced by
# KiCad DRC once the pairs are routed. NOT routing — constraints only.

(rule "intra_skew_ETH_PHY_MDI0_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 0 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (1000BASE-T, 100Ω±15% MDI); ANSI/TIA-568 link; PHY-vendor (RTL8211F / TI SNLA387) layout: intra-pair ≤ 50 mil, inter-pair ≤ 50 mm (~330 ps)
  (condition "(A.NetName == 'ETH_PHY_MDI0_P' && B.NetName == 'ETH_PHY_MDI0_N') || (A.NetName == 'ETH_PHY_MDI0_N' && B.NetName == 'ETH_PHY_MDI0_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_PHY_MDI1_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 1 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); RTL8211F/TI SNLA387 layout: intra-pair ≤50 mil, inter-pair ≤50 mm
  (condition "(A.NetName == 'ETH_PHY_MDI1_P' && B.NetName == 'ETH_PHY_MDI1_N') || (A.NetName == 'ETH_PHY_MDI1_N' && B.NetName == 'ETH_PHY_MDI1_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_PHY_MDI2_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 2 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); RTL8211F/TI SNLA387 layout: intra-pair ≤50 mil, inter-pair ≤50 mm
  (condition "(A.NetName == 'ETH_PHY_MDI2_P' && B.NetName == 'ETH_PHY_MDI2_N') || (A.NetName == 'ETH_PHY_MDI2_N' && B.NetName == 'ETH_PHY_MDI2_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_ETH_PHY_MDI3_P"
  # Gigabit Ethernet (MDI, PHY-side) — MDI pair 3 (PHY→magnetics); Zdiff 100ohm; DC-coupled
  # spec: IEEE 802.3 Clause 40 (100Ω±15%); RTL8211F/TI SNLA387 layout: intra-pair ≤50 mil, inter-pair ≤50 mm
  (condition "(A.NetName == 'ETH_PHY_MDI3_P' && B.NetName == 'ETH_PHY_MDI3_N') || (A.NetName == 'ETH_PHY_MDI3_N' && B.NetName == 'ETH_PHY_MDI3_P')")
  (constraint skew (max 1.27mm))
)

(rule "intra_skew_USB_UART_DP"
  # USB 2.0 FS (UART console, USB-C UFP) — USB2 D+/D- (CP2102N); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 (90Ω±15% diff); USB-IF FS/HS layout intra-pair ≤150 mil
  (condition "(A.NetName == 'USB_UART_DP' && B.NetName == 'USB_UART_DM') || (A.NetName == 'USB_UART_DM' && B.NetName == 'USB_UART_DP')")
  (constraint skew (max 3.81mm))
)

(rule "intra_skew_USB_D"
  # USB 2.0 HS (OTG, Type-C host port) — USB2 D+/D- (OTG); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 / 7.1.6 (90Ω±15% differential HS); USB-IF/HS layout: intra-pair ≤150 mil (~1.6 mm), target ≤5 mm
  (condition "(A.NetName == 'USB_D+' && B.NetName == 'USB_D-') || (A.NetName == 'USB_D-' && B.NetName == 'USB_D+')")
  (constraint skew (max 3.81mm))
)

(rule "intra_skew_STM32_USB_D_P"
  # USB 2.0 HS (USB-C PD/device port) — USB2 D+/D- (PD/STM32); Zdiff 90ohm; DC-coupled
  # spec: USB 2.0 Spec Sec 7.1.1.3 / 7.1.6 (90Ω±15%); USB-IF HS layout intra-pair ≤150 mil
  (condition "(A.NetName == 'STM32_USB_D_P' && B.NetName == 'STM32_USB_D_N') || (A.NetName == 'STM32_USB_D_N' && B.NetName == 'STM32_USB_D_P')")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_GIGABIT_ETHERNET_MDI_PHY_SIDE"
  # Gigabit Ethernet (MDI, PHY-side): 4 pair(s) length-matched as a group (inter-pair), tol +/-50 mil
  (condition "A.NetName == 'ETH_PHY_MDI0_P' || A.NetName == 'ETH_PHY_MDI0_N' || A.NetName == 'ETH_PHY_MDI1_P' || A.NetName == 'ETH_PHY_MDI1_N' || A.NetName == 'ETH_PHY_MDI2_P' || A.NetName == 'ETH_PHY_MDI2_N' || A.NetName == 'ETH_PHY_MDI3_P' || A.NetName == 'ETH_PHY_MDI3_N'")
  (constraint skew (max 1.27mm))
)

(rule "lenmatch_LM_USB_2_0_FS_UART_CONSOLE_USB_C_UFP"
  # USB 2.0 FS (UART console, USB-C UFP): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'USB_UART_DP' || A.NetName == 'USB_UART_DM'")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_USB_2_0_HS_OTG_TYPE_C_HOST_PORT"
  # USB 2.0 HS (OTG, Type-C host port): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'USB_D+' || A.NetName == 'USB_D-'")
  (constraint skew (max 3.81mm))
)

(rule "lenmatch_LM_USB_2_0_HS_USB_C_PD_DEVICE_PORT"
  # USB 2.0 HS (USB-C PD/device port): 1 pair(s) length-matched as a group (inter-pair), tol +/-150 mil
  (condition "A.NetName == 'STM32_USB_D_P' || A.NetName == 'STM32_USB_D_N'")
  (constraint skew (max 3.81mm))
)

