(version 1)

# Generated by schgen/generate/pcb.py — board-level design rules for
# the PCB foundation. Stackup: JLCPCB JLC04161H-7628 (4L 1.6mm).
# Net classes + per-net assignment live in the .kicad_pro net_settings;
# these rules pin the geometry KiCad's DRC enforces.

(rule "minimum_clearance"
  (constraint clearance (min 0.15mm))
)

(rule "minimum_track"
  (constraint track_width (min 0.2032mm))
)

(rule "POWER_track"
  (condition "A.NetClass == 'POWER'")
  (constraint track_width (min 0.4mm) (opt 0.4mm))
)

(rule "DP100_DIFF_geometry"
  (condition "A.NetClass == 'DP100_DIFF'")
  (constraint track_width (min 0.2052mm) (opt 0.2052mm) (max 0.2052mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP90_USB_geometry"
  (condition "A.NetClass == 'DP90_USB'")
  (constraint track_width (min 0.2611mm) (opt 0.2611mm) (max 0.2611mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)
