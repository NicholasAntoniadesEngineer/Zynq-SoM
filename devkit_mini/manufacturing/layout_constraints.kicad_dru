(version 1)

# Generated by schgen/constraints.py from typed ports.
# Stackup: JLCPCB JLC06161H-3313 (6L 1.6mm, 3313 prepreg 0.0994mm).
# Geometry source: field solve on JLCPCB's published calculation parameters, checked against its calculator on JLC04161H-7628
# (90R diff: 0.1455/0.2032mm; 100R diff: 0.1148/0.2032mm, outer vs L2).
# Assign nets to the classes listed in layout_constraints.csv first.

(rule "DP100_DIFF_geometry"
  (condition "A.NetClass == 'DP100_DIFF'")
  (constraint track_width (min 0.1148mm) (opt 0.1148mm) (max 0.1148mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)

(rule "DP90_USB_geometry"
  (condition "A.NetClass == 'DP90_USB'")
  (constraint track_width (min 0.1455mm) (opt 0.1455mm) (max 0.1455mm))
  (constraint diff_pair_gap (min 0.2032mm) (opt 0.2032mm))
)
